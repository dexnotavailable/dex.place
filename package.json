{
  "name": "dex-place",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "node --test \"src/site/*.test.mjs\" \"src/site/build/*.test.mjs\"",
    "gallery:derive": "node src/site/build/derive-gallery.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "jsqr": "1.4.0",
    "marked": "18.0.14",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "lean-qr": "2.7.4"
  }
}
