   "ccc",
   "chc"
  ]
 },
 "whites": {
  "_doc": "white pixel in the first open row under the lash = W2 (lid shadow); lower rows W1; the white beside the highlight = W2 so the A5 highlight keeps its edge (A5/W1 is 1.03:1)",
